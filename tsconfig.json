{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["vite/client", "unplugin-icons/types/react"]
  },
  "include": ["src", "scripts"],
  "exclude": ["src-astro", "dist", ".output", "node_modules"]
}
